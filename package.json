{
  "name": "project-astra",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Windows desktop foundation for Astra",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "lint": "eslint .",
    "test": "npm run build && node --test tests/*.test.mjs",
    "build": "npm run typecheck && tsc -p tsconfig.main.json && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload/index.js && vite build",
    "verify:desktop": "node scripts/verify-desktop.mjs",
    "measure:world": "npm run build && node scripts/measure-world.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
